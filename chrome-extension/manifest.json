{
  "manifest_version": 3,
  "name": "Rotten",
  "version": "0.2.4",
  "description": "Keeps Chrome history clean. See View Rules to see what rules are built-in & rules that have been added.\n\n",
  "permissions": ["history", "storage", "bookmarks", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rotten",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "options.html"
}

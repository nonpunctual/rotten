{
  "manifest_version": 3,
  "name": "Rotten",
  "version": "1.3.8",
  "description": "Keep your Google Chrome history clean. See View Rules for built-in, allow & deny rule lists.\n\n",
  "permissions": ["history", "storage", "bookmarks", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rotten",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "options.html"
}

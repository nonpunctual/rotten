{
    "manifest_version": 3,
    "name": "Rotten",
    "version": "3.0.0",
    "key": "",
    "permissions": ["history", "bookmarks", "storage", "activeTab"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon128.png"
    },
    "icons": {
        "128": "icon128.png"
    }
}
